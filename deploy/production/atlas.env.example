# Install as /etc/waset-atlas/atlas.env (root:atlas, mode 0640).
# Example values only. The Monday token itself belongs only in the separate mode-0640 secret file.

# Pin an immutable, reviewed production image digest. Never use latest.
ATLAS_IMAGE=registry.example.com/waset/atlas@sha256:REPLACE_WITH_REVIEWED_DIGEST

# The compose bind mount exposes the host data directory at this container path.
ATLAS_DATA_DIR=/var/lib/atlas
ATLAS_HISTORY_START=2026-02-01T00:00:00Z
ATLAS_SYNC_INTERVAL_SECONDS=3600
ATLAS_STALE_AFTER_SECONDS=7200
ATLAS_MAX_CONSECUTIVE_FAILURES=3
ATLAS_SYNC_MAX_DURATION_SECONDS=7200

# Approved source contract and read-only Monday API settings.
ATLAS_CONTRACT_VERSION=1.4.0
ATLAS_MONDAY_BOARD_ID=5091110326
MONDAY_API_VERSION=2025-04
MONDAY_API_TOKEN_FILE=/run/secrets/monday_api_token
