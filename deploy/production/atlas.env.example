# Install as /etc/waset-atlas/atlas.env (root-owned, mode 0600).
# Example values only. The Monday token belongs only in ATLAS_TOKEN_FILE.

# Pin reviewed immutable image digests in production; never use `latest`.
ATLAS_APP_IMAGE=registry.example.com/waset/atlas-app@sha256:REPLACE_WITH_REVIEWED_DIGEST
ATLAS_WEB_IMAGE=registry.example.com/waset/atlas-web@sha256:REPLACE_WITH_REVIEWED_DIGEST

# Host paths and the numeric identity used by the non-root Atlas process.
ATLAS_HOST_DATA_DIR=/var/lib/waset-atlas
ATLAS_TOKEN_FILE=/etc/waset-atlas/secrets/monday_api_token
ATLAS_UID=10001
ATLAS_GID=10001
ATLAS_HTTP_BIND=127.0.0.1
ATLAS_HTTP_PORT=18000

# Canonical Atlas production configuration. Inside the container ATLAS_DATA_DIR
# is fixed to /var/lib/waset-atlas so Task 5 relative publication links remain valid.
ATLAS_HISTORY_START=2026-02-01T00:00:00Z
ATLAS_SYNC_INTERVAL_SECONDS=3600
ATLAS_STALE_AFTER_SECONDS=7200
ATLAS_MAX_CONSECUTIVE_FAILURES=3
ATLAS_SYNC_MAX_DURATION_SECONDS=7200
ATLAS_CONTRACT_VERSION=1.4.0
ATLAS_MONDAY_BOARD_ID=5091110326
MONDAY_API_VERSION=2025-04
MONDAY_API_TOKEN_FILE=/run/secrets/monday_api_token
