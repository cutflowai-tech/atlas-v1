# Reasoning V3 deployment configuration template (Phase 20-B preparation). Install as /etc/waset-atlas/reasoning.env (root-owned,
# mode 0600) only when live rollout is approved. Example values only: no credential, token, private key or database URL belongs here.
# Every credential is a root-owned file under /etc/waset-atlas/secrets (mode 0640, group atlas) mounted read-only at /run/secrets and
# read through the application's existing *_FILE handling.

# Pin the reviewed immutable Reasoning V3 operations image digest (Dockerfile.reasoning); never `latest`.
ATLAS_REASONING_IMAGE=registry.example.com/waset/atlas-reasoning@sha256:REPLACE_WITH_REVIEWED_DIGEST

# Host secret files (Compose bind sources). Each holds exactly one value and a final newline.
#   reasoning_database_url : the canonical Reasoning V3 PostgreSQL URL (a dedicated role; never the evaluation/test database)
#   openrouter_api_key     : the OpenRouter key (required only for live reasoning calls)
#   honcho_api_key         : the Honcho key; may be an empty file while ATLAS_REASONING_MEMORY=off
ATLAS_REASONING_HOST_DATABASE_URL_FILE=/etc/waset-atlas/secrets/reasoning_database_url
ATLAS_REASONING_HOST_OPENROUTER_KEY_FILE=/etc/waset-atlas/secrets/openrouter_api_key
ATLAS_REASONING_HOST_HONCHO_KEY_FILE=/etc/waset-atlas/secrets/honcho_api_key

# Capabilities stay OFF until their stage is approved (docs/REASONING-V3-PRODUCTION-ROLLOUT.md §5). Turning one off is the first rollback step.
# These are the application's switches: the master switch and memory (existing), and Phase 20-A's planned rollout controls (PR #45;
# inert until it merges; then `python -m atlas_reasoning rollout --stages` prints each stage's exact values and `rollout` validates a
# change, exit 2 on an invalid combination). Values below are stage 0 (off).
ATLAS_REASONING_V3=off
ATLAS_REASONING_EXECUTION=on
ATLAS_REASONING_AUDIENCE=none
ATLAS_REASONING_CARDS_PRIMARY=off
ATLAS_REASONING_HUMAN_CONTEXT=off
ATLAS_REASONING_EXECUTIVE_HOME=off
ATLAS_REASONING_MEMORY=off
ATLAS_REASONING_ENVIRONMENT=production

# Model: empty = the pinned production model. A rollback to another model needs both values and a reviewed reason; Phase 19 release
# eligibility evaluates the pinned model only, so an override is an incident measure, never a release configuration.
ATLAS_REASONING_MODEL=
ATLAS_REASONING_ALLOW_MODEL_OVERRIDE=off

# Phase 18 provider controls (settings.ReliabilitySettings / GatewaySettings). Bounded starting values; review before each stage.
ATLAS_REASONING_LLM_TIMEOUT_SECONDS=120
ATLAS_REASONING_LLM_MAX_RETRIES=3
ATLAS_REASONING_LLM_BACKOFF_SECONDS=2
ATLAS_REASONING_LLM_MAX_BACKOFF_SECONDS=60
ATLAS_REASONING_LLM_CONCURRENCY=4
ATLAS_REASONING_RUN_CALL_BUDGET=200
ATLAS_REASONING_EXECUTIVE_CALL_BUDGET=3
ATLAS_REASONING_BREAKER_THRESHOLD=5
ATLAS_REASONING_BREAKER_COOLDOWN_SECONDS=60
ATLAS_REASONING_VALIDATION_RETRIES=1

# Web process settings (used only when the Reasoning V3 web process exists; docs/REASONING-V3-PRODUCTION-ROLLOUT.md §2). The proxy authenticates;
# the actor header, if used, must be set and stripped from clients by that proxy.
ATLAS_REASONING_MANAGERS=manager@example.com
ATLAS_REASONING_ALLOWED_ORIGINS=https://atlas.wasetco.com
ATLAS_REASONING_CSRF_SECRET_FILE=/run/secrets/reasoning_csrf_secret
