FROM nginxinc/nginx-unprivileged:1.28.0-alpine@sha256:c97ff0bf7cbae369953c6da1232ec14ad9f971d66360c5698db0856a4cd657a0

USER root
RUN install -d -o 10001 -g 10001 -m 0755 /var/lib/waset-atlas
COPY deploy/production/nginx.conf /etc/nginx/conf.d/default.conf
RUN chown root:root /etc/nginx/conf.d/default.conf && chmod 0444 /etc/nginx/conf.d/default.conf
USER 101:101

VOLUME ["/var/lib/waset-atlas"]
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/en/dashboard.html"]
