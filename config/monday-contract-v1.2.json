      },
      {
        "monday_person_id": "18",
        "editor_id": "editor-label-18",
        "display_name": "Mohamed Mansour (Office)"
      }
    ],
    "unresolved_policy": "quarantine-from-per-editor-metrics",
    "shared_accounts_never_infer_editor": [
      "99154021"
    ]
  },
  "video_type_cohorts": {
    "mapping_version": "monday-video-type-v1.1",
    "label_to_id": {
      "Class B": "5",
      "Ai": "16",
      "Class A+": "8"
    },
    "multi_select_policy": "exact-normalized-full-set",
    "cohort_key": "sorted-canonical-video-type-ids",
    "comparison_policy": "same-resolved-cohort-only-no-global-fallback",
    "unresolved_policy": "quarantine-from-cohort-comparisons"
  },
  "quarantine_policy": {
    "unmapped_deprecated_or_new_status": true,
    "missing_ambiguous_or_unresolved_editor": true,
    "blank_unknown_or_new_video_type": true,
    "silent_inference": false
  },
  "source_board": {
    "board_id": "5091110326",
    "status_column_id": "project_status",
    "editor_column_id": "dropdown_mm1emgt8",
    "video_type_column_id": "dropdown_mm062ga0",
    "requested_eta_column_id": "date",
    "performance_issues_column_id": "dropdown_mm3tyk8g",
    "evidence": "read-only Monday columns query 2026-09-28; DATA-001 scope"
  },
  "cycle_attributes": {
    "policy_version": "cycle-attributes-v1.0",
    "editor": "value-in-effect-at-ready-for-approval-from-editor-column-events",
    "video_type": "value-in-effect-at-ready-for-approval-from-video-type-column-events",
    "editor_changed_within_cycle": "quarantine-from-per-editor-metrics",
    "missing_column_event_history": "unresolved-no-snapshot-substitution",
    "cycle_selection": "first-completed-in-progress-to-ready-for-approval-only; later cycles retained as evidence, never added to or replacing the first",
    "duration": "elapsed-clock-time; nights, weekends, holidays and non-working hours are not excluded",
    "decision_source": "Waset management decisions 2026-09-28"
  },
  "transition_roles": {
    "mapping_version": "monday-transition-role-v1.0",
    "purpose": "context-and-audit-only; the evaluated Editor always comes from the Editor Name field",
    "rules": [
      {
        "from": "In Progress",
        "to": "Ready For Approval",
        "role": "editor"
      },
      {
        "from": "Revisions",
        "to": "Ready For Approval",
        "role": "editor"
      },
      {
        "from": "Ready For Approval",
        "to": "In Progress",
        "role": "editor"
      },
      {
        "from": "*",
        "to": "Revisions",
        "role": "editor",
        "note": "status change performed by the Editor; the revision itself is a client revision and is context only"
      },
      {
        "from": "Ready For Approval",
        "to": "Sent",
        "role": "production_manager"
      }
    ],
    "unlisted_transition_policy": "unresolved",
    "shared_account_ids": [
      "99154021"
    ],
    "shared_account_policy": "never-identifies-a-person; role comes from the transition rule only"
  },
  "quality_labels": {
    "mapping_version": "monday-performance-issues-v1.0",
    "column_id": "dropdown_mm3tyk8g",
    "column_title": "Performance Issues",
    "id_to_label": {
      "1": "Late Delivery",
      "2": "Poor Communication",
      "3": "2- Quality Issue",
      "4": "1- Did Not Follow Instructions",
      "5": "3- Technical Issues",
      "6": "Excessive Revisions",
      "7": "4- Recurring Mistakes"
    },
    "weighting": "one-occurrence-per-label-per-item-equal-weight",
    "occurrence_basis": "label present on the item; evidence is the activity log that added it",
    "unmapped_policy": "quarantine"
  },
  "deadline": {
    "rule_version": "deadline-v1.0",
    "requested_eta_selection": "latest-available-requested-eta",
    "delta": "ready_for_approval_at - latest_requested_eta; negative is early, positive is late",
    "on_time": "delta_seconds <= 0 (no tolerance)",
    "requested_eta_history": "retained-as-evidence",
    "missing_requested_eta": "no-result",
    "date_only_requested_eta": "no-result-no-time-guessed",
    "decision_source": "Waset management decision 2026-09-28"
  },
  "speed_benchmark": {
    "rule_version": "speed-benchmark-v1.0",
    "cohort": "exact-video-type-cohort-only",
    "benchmark": "descriptive historical team median of first completed cycles in the same cohort; not an SLA",
    "median": "median of durations; the mean of the two middle values is floored to whole seconds",
    "minimum_editor_sample_size": null,
    "minimum_editor_sample_size_status": "pending-management-decision",
    "below_minimum_or_unset": "report raw values and sample sizes; no faster/slower conclusion",
    "decision_source": "Waset management decision 2026-09-28"
  }
}
