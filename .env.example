# Atlas sync configuration for local or manual runs (example values only, never real secrets).
# Copy to a file OUTSIDE this repository (or use your deployment's secret/env mechanism).
# Real .env files and secret files are ignored by .gitignore.
# The production host uses deploy/production/atlas.env.example instead (Compose fixes ATLAS_DATA_DIR there).
# Every variable below is read by src/atlas_sync/config.py, src/atlas_monday_probe/client.py,
# src/atlas_commander/photos.py or (Reasoning V3 only) src/atlas_reasoning/settings.py; nothing else in src/ reads the environment.
# Never put real values in this file.

# Monday API token: set exactly ONE of these two.
# Prefer a file (e.g. a Docker secret) so the token never appears in the process environment.
MONDAY_API_TOKEN_FILE=/run/secrets/monday_api_token
# MONDAY_API_TOKEN=

# Monday API version header (YYYY-MM). Default: 2025-04, the version used by every validated run.
MONDAY_API_VERSION=2025-04

# Approved Monday contract version. The board, columns and all business mappings come from this contract.
# Production sync accepts 1.4.0 (the default when unset) or 1.5.0 (D52, explicit opt-in); older contracts are refused.
ATLAS_CONTRACT_VERSION=1.4.0
# Optional safety check: must equal the contract's board ID.
ATLAS_MONDAY_BOARD_ID=5091110326

# Data directories: absolute paths outside any Git checkout.
# Either ATLAS_DATA_DIR (derives raw/monday, builds, published, locks) or all three explicit directories.
ATLAS_DATA_DIR=/var/lib/atlas
# ATLAS_RAW_DIR=/var/lib/atlas/raw/monday
# ATLAS_BUILD_DIR=/var/lib/atlas/builds
# ATLAS_PUBLISH_DIR=/var/lib/atlas/published
# Production-operation lock directory (default ATLAS_DATA_DIR/locks); required when ATLAS_DATA_DIR is not set.
# ATLAS_LOCK_DIR=/var/lib/atlas/locks

# Editor photo directory used when building the site.
# Default: ATLAS_DATA_DIR/editor-photos when ATLAS_DATA_DIR is set, otherwise assets/editors in the repository.
# ATLAS_EDITOR_PHOTOS=/var/lib/atlas/editor-photos

# Start of the Monday activity-log history (UTC).
ATLAS_HISTORY_START=2026-02-01T00:00:00Z

# Scheduling and staleness (seconds). The interval must be 300-86400 and less than the stale threshold.
ATLAS_SYNC_INTERVAL_SECONDS=3600
ATLAS_STALE_AFTER_SECONDS=7200
ATLAS_MAX_CONSECUTIVE_FAILURES=3

# Time budget for one sync attempt (seconds). No new stage or Monday request starts once it is spent.
ATLAS_SYNC_MAX_DURATION_SECONDS=7200

# Minimum age of Atlas-owned operational evidence before retention may remove it (seconds, minimum 3600).
# Default 345600 (96 hours).
ATLAS_RETENTION_SECONDS=345600

# --- Development and tests only (read by the Makefile and tests/, never by src/) ---
# make demo / make demo-showcase serve on http://127.0.0.1:$DEMO_PORT (default 8000).
# DEMO_PORT=8000
# Docker image/runtime tests run only with ATLAS_RUN_DOCKER_TESTS=1 and a Docker daemon (make production-container-docker).
# ATLAS_RUN_DOCKER_TESTS=1
# Browser tests are skipped with ATLAS_BROWSER_TESTS=0; ATLAS_CHROME points at a Chrome binary.
# ATLAS_BROWSER_TESTS=0
# ATLAS_CHROME=/path/to/chrome

# --- Reasoning V3 (REV/, docs/REASONING-V3.md); read only by src/atlas_reasoning ---
# Feature flag, default off. Off: nothing in Atlas calls Reasoning V3 and every existing output is unchanged.
# ATLAS_REASONING_V3=off
# PostgreSQL URL of the canonical Reasoning V3 state (set one of the two; prefer the file, e.g. a Docker secret).
# ATLAS_REASONING_DATABASE_URL=postgresql://atlas@127.0.0.1:5432/atlas_reasoning
# ATLAS_REASONING_DATABASE_URL_FILE=/run/secrets/atlas_reasoning_database_url
# Tests only: a disposable database whose name contains "test" (tests drop and recreate its atlas_reasoning schema).
# ATLAS_REASONING_TEST_DATABASE_URL=postgresql://atlas@127.0.0.1:5432/atlas_reasoning_test
# OpenRouter key for GPT-5.6 Sol (set one of the two; prefer the file). Needed only for live provider calls; tests never need it.
# OPENROUTER_API_KEY=
# OPENROUTER_API_KEY_FILE=/run/secrets/openrouter_api_key
# The model is pinned to openai/gpt-5.6-sol; another value is refused unless the override flag is on (evaluation / rollback only).
# ATLAS_REASONING_MODEL=openai/gpt-5.6-sol
# ATLAS_REASONING_ALLOW_MODEL_OVERRIDE=off
# ATLAS_REASONING_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Provider gateway limits (defaults shown).
# ATLAS_REASONING_LLM_TIMEOUT_SECONDS=120
# ATLAS_REASONING_LLM_MAX_RETRIES=3
# ATLAS_REASONING_LLM_BACKOFF_SECONDS=2
# ATLAS_REASONING_LLM_MAX_BACKOFF_SECONDS=60
# ATLAS_REASONING_LLM_CONCURRENCY=4
# Contextual memory (Honcho, docs/REASONING-V3-MEMORY.md). Off by default; PostgreSQL stays canonical either way.
# ATLAS_REASONING_MEMORY=off
# One Honcho workspace per environment: development, test, staging or production.
# ATLAS_REASONING_ENVIRONMENT=development
# Honcho key: set exactly ONE of these two (prefer the file, outside this repo). Tests and CI never need it.
# HONCHO_API_KEY_FILE=/run/secrets/honcho_api_key
# HONCHO_API_KEY=
# ATLAS_HONCHO_BASE_URL=https://api.honcho.dev
# ATLAS_HONCHO_TIMEOUT_SECONDS=10
# Phase 15 guardrails (docs/REASONING-V3-GUARDRAILS.md): corrective re-asks after a refused candidate (0-2), and the optional
# second reviewer for high-impact cases (off by default; never replaces the deterministic validation).
# ATLAS_REASONING_VALIDATION_RETRIES=1
# ATLAS_REASONING_REVIEWER=off
# ATLAS_REASONING_REVIEWER_CASE_TYPES=editor_pattern
