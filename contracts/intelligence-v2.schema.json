{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/contracts/intelligence-v2.schema.json",
  "title": "IntelligenceV2Document",
  "description": "Optional, independently versioned Atlas investigation document. Deterministic findings over contract 1.5+ engine results. Never an input to any metric, component state, Overall Status or Trend; contains no score, rating or ranking of people.",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_version", "intelligence_version", "generated_at", "mode", "publishable", "executable_contract_version", "source", "windows", "video_types",
               "parameters", "coverage", "baselines", "workload_model", "findings", "examined_without_finding", "sections", "executive_brief",
               "investigation_graph", "editors", "detectors", "language_rules", "note"],
  "properties": {
    "document_version": {"const": "2.0.0"},
    "intelligence_version": {"type": "string", "pattern": "^intelligence-v2\\.[0-9]+\\.[0-9]+$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "mode": {"enum": ["approved_only", "review"]},
    "publishable": {"type": "boolean"},
    "executable_contract_version": {"type": "string", "pattern": "^1\\.([5-9]|[1-9][0-9])\\.[0-9]+$"},
    "source": {"type": "object", "required": ["system", "monday_board_id", "retrieved_at"], "properties": {"system": {"const": "monday"}}},
    "windows": {"type": "object", "required": ["timezone", "current", "comparison"], "properties": {"timezone": {"const": "Africa/Cairo"}}},
    "video_types": {"type": "object", "additionalProperties": {"type": "string"}},
    "parameters": {
      "type": "object", "required": ["version", "mode", "publishable", "parameters"],
      "properties": {
        "parameters": {"type": "array", "items": {"type": "object", "required": ["name", "status", "decision_id", "value"],
          "properties": {"status": {"enum": ["approved", "rule_not_approved"]}},
          "allOf": [{"if": {"properties": {"status": {"const": "rule_not_approved"}}}, "then": {"properties": {"value": {"const": null}, "decision_id": {"const": null}}}},
                    {"if": {"properties": {"status": {"const": "approved"}}}, "then": {"properties": {"decision_id": {"type": "string", "pattern": "^D[0-9]+$"}}}}]}}
      }
    },
    "coverage": {"type": "object"},
    "baselines": {"type": "object", "required": ["team", "video_types", "editors", "monthly", "typical_execution", "note", "periods"]},
    "workload_model": {"type": "object", "required": ["definition", "band_rule", "editors", "capacity_classification"]},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "examined_without_finding": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["detector", "scope", "reasons", "facts", "parameters_needed"],
      "properties": {"detector": {"type": "string"}, "scope": {"$ref": "#/$defs/scope"}, "facts": {"type": "object"},
                     "parameters_needed": {"type": "array", "items": {"type": "string"}},
                     "reasons": {"type": "array", "minItems": 1, "items": {"enum": ["rule_not_approved", "insufficient_sample", "insufficient_comparison_group",
                       "insufficient_recent_window", "insufficient_outcome_events", "insufficient_qualifying_editors", "missing_data",
                       "incomplete_timestamp_coverage", "no_effect_at_approved_threshold", "weak_evidence_review_only"]}}}}},
    "sections": {"type": "object", "required": ["top_findings", "needs_attention", "important_improvements", "system_patterns", "editor_specific_patterns",
                                                "hidden_context", "emerging_risk_signals", "data_warnings", "suggested_investigations", "insufficient_evidence"]},
    "executive_brief": {"type": "array", "items": {"type": "object", "required": ["finding_id", "what_happened", "is_it_unusual", "where", "evidence", "why_it_matters", "next_step"]}},
    "investigation_graph": {"type": "object", "required": ["edges", "chains", "rules"],
      "properties": {"edges": {"type": "array", "items": {"type": "object", "required": ["from", "to", "relation"],
        "properties": {"relation": {"enum": ["context_for", "explains_breadth", "supports", "contradicts", "qualifies"]}}}}}},
    "editors": {"type": "array", "items": {"type": "object", "required": ["editor_id", "finding_ids", "strengths", "attention", "context", "fairness_context"]}},
    "detectors": {"type": "array", "items": {"type": "object", "required": ["detector", "version", "purpose", "required_signals", "parameters", "minimum_sample",
                                                                          "output", "confidence_rules", "limitations", "analyses_run", "findings"]}},
    "language_rules": {"type": "object"},
    "note": {"type": "string"}
  },
  "$defs": {
    "scope": {"type": "object", "additionalProperties": false, "required": ["kind", "editor_id", "cohort_key", "stage", "monday_item_id"],
      "properties": {"kind": {"enum": ["team", "editor", "video_type", "stage", "project", "data"]}, "editor_id": {"type": ["string", "null"]},
                     "cohort_key": {"type": ["string", "null"]}, "stage": {"type": ["string", "null"]}, "monday_item_id": {"type": ["string", "null"]}}},
    "statement": {"type": "object", "additionalProperties": false, "required": ["level", "code", "params"],
      "properties": {"level": {"enum": ["fact", "metric", "pattern", "association", "interpretation", "hypothesis"]}, "code": {"type": "string", "minLength": 1},
                     "params": {"type": "object"}}},
    "record": {"type": "object", "additionalProperties": false, "required": ["monday_item_id", "cycle_id", "editor_id", "cohort_key", "event_ids", "source_timestamps", "values"],
      "properties": {"monday_item_id": {"type": "string", "minLength": 1}, "cycle_id": {"type": ["string", "null"]}, "editor_id": {"type": ["string", "null"]},
                     "cohort_key": {"type": ["string", "null"]}, "event_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                     "source_timestamps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "values": {"type": "object"}}},
    "evidence": {"type": "object", "additionalProperties": false,
      "required": ["role", "code", "source", "monday_board_id", "column_ids", "calculation", "sample", "comparison", "time_window", "records", "exclusions"],
      "properties": {"role": {"enum": ["supporting", "contradicting", "context"]}, "code": {"type": "string"}, "source": {"const": "monday"}, "monday_board_id": {"type": ["string", "null"]},
                     "column_ids": {"type": "array"}, "calculation": {"type": "string", "minLength": 1}, "sample": {"type": "object"}, "comparison": {"type": "object"},
                     "time_window": {"type": ["object", "null"]}, "exclusions": {"type": "array"},
                     "records": {"type": "array", "items": {"$ref": "#/$defs/record"}}}},
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["finding_id", "finding_type", "detector_version", "category", "direction", "scope", "evidence_level", "statement_levels", "parameter_status", "statements",
                   "significance", "suggested_investigations", "confidence", "importance", "severity", "sample_size", "affected_editors",
                   "affected_video_types", "affected_projects", "time_window", "supporting_evidence", "contradicting_evidence", "context_evidence",
                   "limitations", "parameters", "headline_contradiction", "worsening", "persistent", "related", "cluster", "text"],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^[a-z_.]+:[0-9a-f]{16}$"},
        "finding_type": {"type": "string", "minLength": 1},
        "detector_version": {"type": "string", "minLength": 1},
        "affected_editors": {"type": "array", "items": {"type": "string"}},
        "affected_video_types": {"type": "array", "items": {"type": "string"}},
        "affected_projects": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "time_window": {"type": ["object", "null"]},
        "parameters": {"type": "array", "items": {"type": "object", "required": ["name", "value", "status", "decision_id"],
          "properties": {"status": {"enum": ["approved", "proposed_not_approved"]}}}},
        "headline_contradiction": {"type": "boolean"},
        "worsening": {"type": ["boolean", "null"]},
        "persistent": {"type": ["boolean", "null"]},
        "related": {"type": "array", "items": {"type": "object", "required": ["finding_id", "relation"]}},
        "cluster": {"type": ["object", "null"]},
        "category": {"enum": ["needs_attention", "important_improvement", "system_pattern", "editor_specific_pattern", "hidden_context", "emerging_risk", "data_warning"]},
        "direction": {"enum": ["adverse", "favourable", "mixed", "neutral"]},
        "scope": {"$ref": "#/$defs/scope"},
        "evidence_level": {"enum": ["fact", "metric", "pattern", "association"]},
        "statement_levels": {"type": "array", "minItems": 1, "items": {"enum": ["fact", "metric", "pattern", "association", "interpretation", "hypothesis"]}},
        "parameter_status": {"enum": ["approved", "proposed_not_approved"]},
        "statements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/statement"}},
        "significance": {"$ref": "#/$defs/statement"},
        "suggested_investigations": {"type": "array", "items": {"$ref": "#/$defs/statement"}},
        "confidence": {"type": "object", "required": ["level", "label", "factors", "rule", "why"], "properties": {"level": {"enum": ["weak", "moderate", "strong"]}}},
        "importance": {"type": "object", "required": ["rank", "tier", "basis", "method"]},
        "severity": {"enum": ["high", "medium", "low", "info"]},
        "sample_size": {"type": "integer", "minimum": 1},
        "supporting_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "contradicting_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "context_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "text": {"type": "object", "required": ["title", "summary", "observation", "interpretation", "management_significance", "suggested_investigation",
                                                 "investigation_question", "confidence_explanation", "limitations", "uncertainty"]}
      }
    }
  }
}
