{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/contracts/common.schema.json",
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "nullableTimestamp": {"type": ["string", "null"], "format": "date-time"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "monday_board_id", "monday_item_id", "column_ids", "event_ids", "source_timestamps", "source_values", "rule_version", "calculated_at"],
      "properties": {
        "source": {"const": "monday"},
        "monday_board_id": {"$ref": "#/$defs/id"},
        "monday_item_id": {"$ref": "#/$defs/id"},
        "column_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "event_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "source_timestamps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/timestamp"}},
        "source_values": {"type": "object", "minProperties": 1},
        "rule_version": {"$ref": "#/$defs/id"},
        "calculated_at": {"$ref": "#/$defs/timestamp"}
      }
    }
  }
}
